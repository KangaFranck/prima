# =============================================================================
# Prima Center - Variables d'environnement (copier vers .env ou .env.local)
# =============================================================================

# --- BDD Neon (obligatoire pour l'API) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- JWT (obligatoire pour l'API / auth admin) ---
JWT_SECRET=une-cle-secrete-longue-et-aleatoire

# --- CORS (origines autorisées, séparées par des virgules) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://prima-five.vercel.app

# --- Cloudflare R2 (upload médias) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=prima-center-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Frontend (Vite) : utiliser l'API au lieu de PocketBase ---
# En local avec vercel dev, l'API est sur http://localhost:3000
VITE_API_URL=http://localhost:3000

# --- Optionnel : seed admin (pour scripts/seed-admin.js) ---
# ADMIN_EMAIL=communicationprimacenter@gmail.com
# ADMIN_PASSWORD=Pr!ma@center#2025
# ADMIN_NAME=Administrateur Principal
