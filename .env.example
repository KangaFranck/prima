# =============================================================================
# Prima Center - Variables d'environnement (copier vers .env ou .env.local)
# =============================================================================

# --- BDD Neon (obligatoire pour l'API) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- JWT (obligatoire pour l'API / auth admin) ---
JWT_SECRET=une-cle-secrete-longue-et-aleatoire

# --- CORS (service API uniquement ; séparées par des virgules) ---
# Inclure TOUS les domaines du front (https, sans slash final) : local, préprod, prod, www.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://prima-five.vercel.app,https://primacenter.store,https://www.primacenter.store

# Si le front est sur un domaine perso ET l’API sur un autre hôte : même liste sur Render (variable ALLOWED_ORIGINS du service API).

# --- Cloudflare R2 (upload médias) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=prima-center-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Frontend (Vite) : si le site est sur un domaine perso et l’API sur Render ---
# Soit au build : VITE_API_URL=https://VOTRE-SERVICE-API.onrender.com
# Soit sans rebuild : remplir public/api-config.json (champ apiBaseUrl) puis déployer.
# En local : VITE_API_URL=http://localhost:3002
VITE_API_URL=http://localhost:3002

# --- Optionnel : seed admin et test auth ---
# ADMIN_EMAIL=votre@email.com
# ADMIN_PASSWORD=votre_mot_de_passe
# ADMIN_NAME=Administrateur Principal
